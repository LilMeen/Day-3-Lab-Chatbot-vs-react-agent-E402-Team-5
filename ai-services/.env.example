# Choose provider: "openai" or "gemini"
LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Google Custom Search API (for compare_prices_google_search)
# 1. Tạo API key tại: https://console.cloud.google.com → Enable "Custom Search API"
# 2. Tạo Search Engine tại: https://programmablesearchengine.google.com → lấy cx (CSE ID)
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_CSE_ID=your-cse-id-here
