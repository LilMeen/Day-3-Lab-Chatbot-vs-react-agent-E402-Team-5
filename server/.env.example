# PostgreSQL config (supports both POSTGRE_* and POSTGRES_*)
POSTGRE_HOST=localhost
POSTGRE_PORT=5432
POSTGRE_USER=postgres
POSTGRE_PASSWORD=postgres
POSTGRE_DB=vinai_lab3

# Optional switches
DB_SYNC=true
DB_SSL=false

# If you prefer POSTGRES_* naming, you can use these instead:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=vinai_lab3
